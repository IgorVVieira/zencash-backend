// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  email              String              @unique
  name               String
  password           String
  status             String              @default("PENDING_VERIFICATION")
  externalCustomerId String?             @map("external_customerId")
  taxIdentifier      String?             @map("tax_identifier")
  cellphone          String?             @map("cellphone")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?           @map("deleted_at")
  categories             Category[]
  transactions           Transaction[]
  verificationTokens     VerificationToken[]
  subscriptions          Subscription[]
  transactionImports     TransactionImport[]
  fixedBills             FixedBill[]
  fixedBillOccurrences   FixedBillOccurrence[]

  @@map("users")
}

model Category {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  name         String
  color        String
  type         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?     @map("deleted_at")
  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]
  fixedBills   FixedBill[]

  @@index([userId], name: "category_user_id_index")
  @@map("categories")
}

model Transaction {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  categoryId  String?   @map("category_id") @db.Uuid
  externalId  String?   @map("external_id") @db.Uuid
  amount      Float
  date        DateTime
  description String
  type        String
  method      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? @map("deleted_at")
  user                 User                  @relation(fields: [userId], references: [id])
  category             Category?             @relation(fields: [categoryId], references: [id])
  fixedBillOccurrences FixedBillOccurrence[]

  @@index([userId], name: "transaction_user_id_index")
  @@index([categoryId], name: "category_id_index")
  @@map("transactions")
}

model VerificationToken {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  token          String    @unique
  expirationDate DateTime
  type           String
  isUsed         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])

  @@map("verification_tokens")
}

model Product {
  id             String @id @default(uuid()) @db.Uuid
  name           String @map("name")
  description    String @map("description")
  price          Float  @map("price")
  features       Json   @map("features")
  durationInDays Int    @map("duration_in_days")

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?      @map("deleted_at")
  subscriptions Subscription[]

  @@map("products")
}

model Subscription {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  productId String    @map("product_id") @db.Uuid
  paymentId String    @map("payment_id")
  startAt   DateTime  @map("start_at")
  endAt     DateTime  @map("end_at")
  price     Float     @map("price")
  status    String    @default("PENDING_PAYMENT") @map("status")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @map("deleted_at")

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("subscriptions")
}

model TransactionImport {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  fileName  String    @map("file_name")
  status    String    @default("PENDING") @map("status")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])

  @@map("transaction_imports")
}

model FixedBill {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  categoryId    String?   @map("category_id") @db.Uuid
  name          String
  amount        Float
  recurrence    String
  dueDay        Int       @map("due_day")
  dueMonth      Int?      @map("due_month")
  matchKeywords String[]  @map("match_keywords")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? @map("deleted_at")

  user        User                  @relation(fields: [userId], references: [id])
  category    Category?             @relation(fields: [categoryId], references: [id])
  occurrences FixedBillOccurrence[]

  @@index([userId], name: "fixed_bill_user_id_index")
  @@map("fixed_bills")
}

model FixedBillOccurrence {
  id             String    @id @default(uuid()) @db.Uuid
  fixedBillId    String    @map("fixed_bill_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  transactionId  String?   @map("transaction_id") @db.Uuid
  dueDate        DateTime  @map("due_date")
  status         String    @default("PENDING")
  paidAmount     Float?    @map("paid_amount")
  referenceMonth Int       @map("reference_month")
  referenceYear  Int       @map("reference_year")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime? @map("deleted_at")

  fixedBill   FixedBill    @relation(fields: [fixedBillId], references: [id])
  user        User         @relation(fields: [userId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@index([fixedBillId], name: "fixed_bill_occurrence_bill_id_index")
  @@index([userId], name: "fixed_bill_occurrence_user_id_index")
  @@map("fixed_bill_occurrences")
}

